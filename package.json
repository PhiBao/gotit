{
  "name": "gotit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "pnpm -r build && node scripts/check-artifacts.mjs",
    "dev": "pnpm --filter @gotit/web dev",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "contract:compile": "pnpm --filter @gotit/contract compile",
    "contract:build": "pnpm --filter @gotit/contract build",
    "check:submission": "node scripts/check-submission.mjs && node scripts/unwrap-submission.mjs --check",
    "dev:all": "concurrently -n web,issuer \"pnpm --filter @gotit/web dev\" \"pnpm --filter @gotit/issuer dev\"",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "unwrap:submission": "node scripts/unwrap-submission.mjs"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "pnpm": {
    "overrides": {
      "@midnight-ntwrk/onchain-runtime-v3": "3.1.0",
      "@midnight-ntwrk/ledger-v8": "8.1.1"
    }
  }
}
