          }
        ]
      }
    },
    {
      "id": "s6_proof",
      "text": "The figures are reproducible, not just asserted. One command reads the ledger and prints the report, and forty-five tests run the generated contract off chain, so a drift between the browser and the circuit fails the build.",
      "scene": {
        "kind": "term",
        "title": "reproduce the filing from public chain state",
        "lines": [
          {
            "at": 0.4,
            "type": "cmd",
            "text": "pnpm verify:chain --address 92fb35db... --categories engineering,sales",
            "cps": 30
          },
          {
            "at": 3.0,
            "text": "reporting period 1   threshold k=5",
            "cls": "dim"
          },
          {
            "at": 3.8,
            "text": "members: 13          submissions: 13",
            "cls": "dim"
          },
          {
            "at": 4.6,
            "text": "reportable rows: 1   withheld: 7",
            "cls": "dim"
          },
          {
            "at": 5.6,
            "type": "rule"
          },
          {
            "at": 6.3,
            "text": "## engineering &middot; Base salary",
            "cls": "white"
          },
          {
            "at": 7.2,
            "text": "   Headcount        5 women    5 men",
            "cls": "dim"
          },
          {
            "at": 8.1,
            "text": "   Mean pay gap     115.0% - 273.3%",
            "cls": "amb"
          },
          {
            "at": 9.2,
            "text": "   No wallet. No key. No permission.",
            "cls": "green",
            "flash": "g"
          },
          {
            "at": 10.6,
            "type": "gap"
          },
          {
            "at": 11.2,
            "type": "cmd",
            "text": "pnpm --filter @gotit/contract test",
            "cps": 30
          },
          {
            "at": 12.8,
            "text": "Tests  45 passed (45)",
            "cls": "green",
            "flash": "g"
          }
        ]
      }
    },
    {
      "id": "s7_setup",
      "text": "Contributing does need a wallet, because it is a transaction. The app says that plainly, and the setup guide walks through it: install Lace, switch to Preprod, wait for the sync to finish, then get free test funds.",
